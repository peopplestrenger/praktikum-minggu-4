<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Mahasiswa</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <header>
        <h1>BOASH University</h1>
        <p>Dashboard Pribadi Mahasiswa</p>
    </header>

    <nav>
        <a href="#profil">Profil</a>
        <a href="#akademik">Akademik</a>
        <a href="#keahlian">Keahlian</a>
        <a href="#kontak">Kontak</a>
    </nav>

    <main>
        <section id="profil">
            <h2>Profil Mahasiswa</h2>
            <div class="card">
                <h3>Kammila</h3>
                <p>NIM: 25903460034</p>
                <p>Program Studi: Teknologi Rekayasa Multimedia</p>
                <p>Universitas: BOASH University</p>
            </div>
        </section>

        <section id="akademik">
            <h2>Data Akademik</h2>
            <div class="card">
                <p>Semester: 2</p>
                <p>IPK: 3.85</p>
                <p>Total SKS: 24</p>
                <p>Status: Mahasiswa Aktif</p>
            </div>
        </section>

        <section id="keahlian">
            <h2>Keahlian</h2>
            <div class="card">
                <p>HTML</p>
                <div class="bar"><div class="html"></div></div>

                <p>CSS</p>
                <div class="bar"><div class="css"></div></div>

                <p>UI/UX Design</p>
                <div class="bar"><div class="uiux"></div></div>
            </div>
        </section>

        <section id="kontak">
            <h2>Kontak Mahasiswa</h2>
            <div class="card">
                <p>Email: kammilataufik@gmail.com</p>
                <p>Telepon: 085198462565</p>
                <p>Lokasi: Bogor, Indonesia</p>
            </div>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 BOASH University</p>
    </footer>
</body>
</html>


* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f2f4f8;
    color: #333;
}

header {
    background: #292653;
    color: white;
    text-align: center;
    padding: 25px;
}

nav {
    background: #443d7a;
    text-align: center;
    padding: 15px;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 15px;
}

nav a:hover {
    color: #ffd166;
}

main {
    width: 85%;
    max-width: 900px;
    margin: 25px auto;
}

section {
    margin-bottom: 25px;
}

h2 {
    color: #292653;
    margin-bottom: 12px;
}

.card {
    background: white;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 3px 10px #ddd;
}

.card p {
    margin: 10px 0;
}

.bar {
    height: 10px;
    background: #ddd;
    border-radius: 10px;
    margin-bottom: 15px;
}

.html {
    width: 70%;
    height: 100%;
    background: #6556c7;
    border-radius: 10px;
}

.css {
    width: 60%;
    height: 100%;
    background: #6556c7;
    border-radius: 10px;
}

.uiux {
    width: 50%;
    height: 100%;
    background: #6556c7;
    border-radius: 10px;
}

footer {
    background: #292653;
    color: white;
    text-align: center;
    padding: 15px;
}

@media (max-width: 600px) {
    main {
        width: 92%;
    }

    nav a {
        display: inline-block;
        margin: 5px;
    }
}
